  "agent_guidance": {
    "decision_priorities": [
      "先检查是否仍有缺门牌；若有缺门牌，优先建议打缺门。",
      "再判断当前手牌更接近标准胡、七对、碰碰胡、清一色、将对或将七对。",
      "若2、5、8数量和对子数量很多，优先评估将对、将七对、将龙七对路线。",
      "若对子很多且没有碰杠，优先评估七对及龙七对路线。",
      "若同一花色数量明显占优，优先评估清一色路线。",
      "只给出出牌建议时，要解释建议牌为什么价值最低，以及保留哪些搭子、对子或番型机会。"
    ],
    "avoid_assumptions": [
      "不要加入字牌、风牌、三元牌相关番型。",
      "不要建议吃牌，因为规则明确不能吃。",
      "不要按国标麻将、日本立直麻将或广东麻将的番型表推断。",
      "没有截图证据时，不要新增未列出的番型。"
    ],
    "response_style": [
      "面向新手时，先给结论，再用1到3句解释。",
      "实战建议应包含：推荐打牌、备选打牌、当前可能路线、需要注意的危险点。",
      "如果截图牌面无法识别，应要求用户补充手牌文字或更清晰截图。"
    ]
  }
